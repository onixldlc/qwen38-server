# AUTO_SCALE=1 reads the card's VRAM at start and picks MODEL_FILE, CTX_SIZE and
# the KV cache type for you, so one template works on any card:
#
#   24 GB -> UD-Q4_K_XL  + 128K q8_0 KV      48 GB -> UD-Q5_K_XL + 128K f16 KV
#   32 GB -> UD-Q5_K_XL  +  96K f16  KV      64 GB+ -> UD-Q6_K_XL + whatever fits
#   16 GB -> UD-Q3_K_XL, 12 GB -> UD-Q2_K_XL, both sized to what is left
#
# Set AUTO_SCALE=0 to pin MODEL_FILE and CTX_SIZE below instead.
AUTO_SCALE=1

# Only read when AUTO_SCALE=0. 17.6 GB, the best fit for 24 GB.
# UD-Q3_K_XL = 13.2 GB for 16 GB. UD-Q2_K_XL = 9.8 GB for 12 GB.
MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf

# Vision tower (+0.93 GB). 0 = text only.
ENABLE_VISION=1

# Only read when AUTO_SCALE=0. A number, or 'auto' to drop --ctx-size entirely
# and let llama.cpp's own fitter size the KV pool against free VRAM (it is on by
# default and measures compute buffers instead of estimating them).
# With q8_0 KV: 12 GB -> 65536 | 16 GB -> 98304 | 24 GB -> 131072
CTX_SIZE=131072

# Headroom left free on the card, MiB. Same default as llama.cpp's --fit-target.
FIT_MARGIN_MIB=1024

N_GPU_LAYERS=99
FLASH_ATTN=on

# Thinking preset: --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.05
# --tools hands the model llama.cpp's built-in agent tools. They resolve relative
# paths against the server's working directory, /workspace — mount a project
# there (see compose.yaml). exec_shell_command is deliberately left out.
# Reasoning effort defaults to xhigh, which overthinks and loops on this model;
# add --chat-template-kwargs '{"reasoning_effort":"medium"}' for normal use.
# Never take the KV cache below q8_0 here.
EXTRA_ARGS=--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.05 --tools read_file,write_file,edit_file,file_glob_search,grep_search,get_info --cache-type-k q8_0 --cache-type-v q8_0

# Retries per file before giving up (each resumes, it never restarts from 0).
DOWNLOAD_ATTEMPTS=20

# Optional: only raises HF rate limits, not required for this public repo.
# HF_TOKEN=

# --- Web tools (MCP) --------------------------------------------------------
# 1 exposes web_search / web_fetch to the model. Enabling tools also makes
# llama-server default --cors-origins to localhost.
MCP_ENABLE=0

# Empty = DuckDuckGo lite endpoint, no key and no account. Point at your own
# SearXNG to keep queries on your network (needs `json` in its search.formats).
SEARXNG_URL=
SEARCH_RESULTS=8
FETCH_MAX_CHARS=20000
HTTP_TIMEOUT=20
